{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Pomodoro",
  "version": "1.0.0",
  "identifier": "com.pomodoro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pomodoro",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "center": true,
        "url": "index.html"
      },
      {
        "label": "mini",
        "title": "Pomodoro Mini",
        "width": 232,
        "height": 212,
        "minWidth": 150,
        "minHeight": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "index.html#/mini"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
